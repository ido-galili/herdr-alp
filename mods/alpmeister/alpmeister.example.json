{
  "account": {
    "repos": "all",
    "exclude": ["your-org/old-prototype"],
    "archived": false,
    "launch": {
      "issue": "Work on GitHub issue {repo}#{number}: read it, plan, then implement.",
      "pr": "Review GitHub PR {repo}#{number} and summarize what needs attention."
    },
    "folders": {
      "your-org/your-repo": "~/code/your-repo"
    },
    "queries": {
      "review": "is:pr draft:false is:open review-requested:@me sort:updated-desc",
      "mine": "is:issue is:open assignee:@me sort:updated-desc",
      "myPrs": "is:pr is:open author:@me draft:false sort:updated-desc"
    }
  },
  "workspaces": [
    {
      "name": "Your team",
      "repo": "your-org/your-repo",
      "board": {
        "owner": "your-org",
        "number": 1,
        "title": "Your board",
        "statusField": "Status",
        "iterationField": "Iteration"
      },
      "statuses": ["Backlog", "Todo", "In Progress", "In Review", "QA", "Done", "On Hold"],
      "notStarted": ["Backlog", "Todo"],
      "inFlight": {
        "statuses": ["In Progress", "In Review", "QA"],
        "excludeTypes": ["Epic"]
      },
      "mineHidden": ["Backlog", "Done", "On Hold"],
      "boardView": {
        "query": "type:Task,Bug,Story iteration:@current,@previous",
        "statuses": ["Todo", "In Progress", "In Review", "QA", "Done"]
      },
      "queries": {
        "triage": "is:issue is:open type:Bug label:triage",
        "prs": "is:pr is:open"
      },
      "bugs": {
        "query": "is:issue is:open type:Bug",
        "priorityField": "Priority",
        "priorities": ["Blocker", "Critical", "Major", "Minor"]
      },
      "spotlight": {
        "milestones": 2,
        "labels": ["product-prioritized"],
        "featureTypes": ["Epic", "Story", "Improvement"],
        "holdStatus": "On Hold"
      },
      "customer": {
        "labelMatch": "customer"
      },
      "nightly": {
        "workflow": "nightly.yml",
        "branch": "main",
        "events": ["schedule", "workflow_dispatch"],
        "checks": [
          { "name": "Deploy", "exceptJobs": ["API Tests", "E2E Tests"] },
          { "name": "Unit tests", "job": "Build", "step": "Unit Tests" },
          { "name": "API tests", "job": "API Tests" },
          { "name": "E2E tests", "job": "E2E Tests" }
        ]
      }
    },
    {
      "name": "side-project",
      "repo": "you/side-project"
    }
  ],
  "files": {
    "autoSave": "afterDelay",
    "autoSaveDelay": 1000
  }
}
