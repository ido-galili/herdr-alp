{
  "id": "root",
  "theme": "alp",
  "cloned_from": {
    "name": "main",
    "version": "0.1.14"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "alp-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "limits",
              "type": "block",
              "size": {
                "px": 96
              },
              "content": {
                "mod": "usage-limits"
              }
            },
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "alp-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "alp-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "alp-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 41
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "alp-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-stack",
          "type": "stack",
          "children": [
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane-agent"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                }
              ],
              "padding": 8,
              "gap": 8
            },
            {
              "id": "alpmeister-view",
              "type": "block",
              "content": {
                "mod": "alpmeister"
              }
            }
          ],
          "active": "work-body"
        },
        {
          "id": "bottom-panel",
          "type": "column",
          "children": [
            {
              "id": "runs-bar",
              "type": "block",
              "content": {
                "mod": "alp-runs",
                "props": {
                  "part": "bar"
                }
              },
              "size": {
                "px": 34
              }
            },
            {
              "id": "runs-body",
              "type": "row",
              "children": [
                {
                  "id": "run-output",
                  "type": "block",
                  "content": {
                    "mod": "alp-runs",
                    "props": {
                      "part": "empty"
                    }
                  }
                },
                {
                  "id": "runs-sessions",
                  "type": "block",
                  "content": {
                    "mod": "alp-runs",
                    "props": {
                      "part": "sessions"
                    }
                  },
                  "size": {
                    "px": 220
                  },
                  "min": 160,
                  "max": 420
                }
              ],
              "divider": {
                "width": 1,
                "color": "border"
              }
            }
          ],
          "size": {
            "px": 280
          },
          "min": 140,
          "max": 720,
          "background": "chrome",
          "hidden": true
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "alp-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    },
    {
      "id": "basecamp",
      "type": "column",
      "children": [
        {
          "id": "basecamp-header",
          "type": "block",
          "content": {
            "mod": "basecamp"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "basecamp-body",
          "type": "stack",
          "children": [
            {
              "id": "files",
              "type": "block",
              "content": {
                "mod": "alp-files"
              },
              "padding": 8
            },
            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "changes"
              },
              "padding": 8
            },
            {
              "id": "basecamp-daypack",
              "type": "block",
              "content": {
                "mod": "daypack"
              }
            },
            {
              "id": "basecamp-run",
              "type": "block",
              "content": {
                "mod": "alp-runs",
                "props": {
                  "part": "list"
                }
              }
            }
          ],
          "active": "basecamp-daypack"
        }
      ],
      "size": {
        "px": 360
      },
      "min": 300,
      "max": 900,
      "background": "chrome",
      "hidden": true
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
